# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Porta do servidor (no Render isso é automático)
PORT=3000

# Banco de dados PostgreSQL (Supabase, Neon, Render...)
# Exemplo Supabase: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Use "false" só se rodar um Postgres local sem SSL
DATABASE_SSL=true

# Segredo para as sessões de login (qualquer texto longo e aleatório)
JWT_SECRET=troque-por-um-texto-bem-longo-e-aleatorio

# Inteligência artificial: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_API_KEY=
# Opcional: modelo específico. Se vazio, usa o padrão do provedor.
AI_MODEL=
